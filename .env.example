# ── TriModel API Key Configuration ──
# Copy this file to .env and fill in your keys.
# .env is gitignored and must never be committed.
#
# Key resolution order:
#   1. Constructor param (instance-level, no global pollution)
#   2. This .env file (key pool baseline, shared by all consumers)
#
# Consumers import TriModel with zero config:
#   import { createModelClient } from 'trimodel';
#   const client = createModelClient(); // uses .env defaults
#
# Instance-level override (doesn't affect other consumers in same process):
#   const client = createModelClient({ deepseekApiKey: 'sk-custom' });

# ── L1: Direct Provider Keys ──
# DeepSeek (current default provider)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Future providers (uncomment when needed)
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── L2: TriMetaverse Platform Provider (routes through TriStaciss) ──
# This is a TriMetaverse-issued key (tmv-sk-*), NOT a real model key.
# TriStaciss internally holds real model keys (L3, opaque to TriModel).
TRIMODEL_TRIMETAVERSE_API_KEY=tmv-sk-dev-default
TRIMODEL_TRISTACISS_BASE_URL=http://127.0.0.1:8000/v1

# ── Provider Selection ──
TRIMODEL_PRIMARY_PROVIDER=deepseek
TRIMODEL_DEFAULT_MODEL=deepseek-chat
TRIMODEL_FALLBACK_MODEL=deepseek-chat
TRIMODEL_REQUEST_TIMEOUT_MS=60000

# ── Server Config (configuration-plane only) ──
# HTTP listen address/port
TRIMODEL_PORT=3333
TRIMODEL_HOST=127.0.0.1

# API authentication token for config endpoints (/v1/config/*)
# Required for GET /v1/config/keys and POST /v1/config/keys/refresh
TRIMODEL_API_TOKEN=
TRIMODEL_KEY_REFRESH_INTERVAL_S=900
