{
  "name": "trimodel",
  "version": "0.2.0",
  "private": true,
  "description": "TriMetaverse Provider/Model unified configuration layer",
  "type": "module",
  "engines": {
    "node": ">=18.20.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "serve": "tsx src/server.ts",
    "serve:proxy": "tsx src/proxy-server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-ui.mjs",
    "build:verify": "npm run build && node scripts/build-verify.mjs",
    "start:server": "node dist/src/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "lint": "eslint src/ test/ --max-warnings 200",
    "lint:fix": "eslint src/ test/ --fix --max-warnings 200"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0"
  }
}
